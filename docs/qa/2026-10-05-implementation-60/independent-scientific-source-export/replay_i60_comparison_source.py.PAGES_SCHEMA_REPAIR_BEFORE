def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result: raise ValueError('Duplicate JSON key: ' + key)
        result[key] = value
    return result

def strict_json(value):
    return json.loads(value, object_pairs_hook=unique_object, parse_constant=lambda value: (_ for _ in ()).throw(ValueError('Nonfinite JSON ' + value)))

def read_file(path):
    path = Path(path); fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    h, parts, offset, calls = hashlib.sha256(), [], 0, 0
    try:
        start = os.fstat(fd)
        while True:
            block = os.pread(fd, 4096, offset); calls += 1
            if not block: break
            parts.append(block); h.update(block); offset += len(block)
        end = os.fstat(fd)
        assert (start.st_ino, start.st_size, start.st_mtime_ns) == (end.st_ino, end.st_size, end.st_mtime_ns)
        assert offset == end.st_size
    finally: os.close(fd)
    return {'bytes': offset, 'sha256': h.hexdigest()}, b''.join(parts), calls

def pin(value): return {key: value[key] for key in ('bytes', 'sha256')}

