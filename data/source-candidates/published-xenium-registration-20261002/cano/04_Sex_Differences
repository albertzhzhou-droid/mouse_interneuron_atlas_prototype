gaba_neurons = readRDS("./Xen_GABA_COMBINED_v9_named.rds")
chol_neurons = readRDS("./Xen_CHOL_COMBINED_v6_named.rds")

#### Create a down-sampled dataset with equal male/female cell representation

## Make sure the datasets has sex and experimental animal information
table(glut_neurons$animal)
table(glut_neurons$sex)

## Downsample datasets to equal sex ID representation
sex_levels <- unique(glut_neurons$sex)
sample_size <- min(table(glut_neurons$sex))

balanced_cells <- unlist(lapply(sex_levels, function(sex) {
  sex_cells <- colnames(glut_neurons[["RNA"]]$count)[glut_neurons$sex == sex]
  sample(sex_cells, sample_size, replace = FALSE)
}))

subset_balanced <- subset(glut_neurons, cells = balanced_cells)
table(subset_balanced$sex)

saveRDS(subset_balanced, "./SEX_balanced_GLUT_Neurons_Xen_v24.rds")


#### Create bargraph of sex biased cell-types
#############################################

glut_balanced = readRDS("./SEX_balanced_GLUT_Neurons_Xen_v24.rds")
gaba_balanced = readRDS("./SEX_balanced_GABA_Neurons_Xen_v9.rds")
chol_balanced = readRDS("./SEX_balanced_CHOL_Neurons_Xen_v6.rds")

glut_balanced = subset_balanced

## Generate prop.table (% proportions) for graphing sex representation across neuron types

percent_df <- as.data.frame(prop.table(table(glut_balanced$neuron_types, glut_balanced$sex), 1))
colnames(percent_df) <- c("type", "sex", "percent")
percent_df$percent <- percent_df$percent * 100

# Make sure clusters are character 
percent_df$type <- as.character(percent_df$type)

# Extract male percentages into named vector to prep reordering
male_percents <- percent_df %>%
  filter(sex == "M") %>%
  select(type, percent) %>%
  { setNames(.$percent, .$type) }

# Makes sure to include clusters that have 0% whatever your grouping by
all_clusters <- unique(percent_df$type)
male_percents_complete <- male_percents[all_clusters]
male_percents_complete[is.na(male_percents_complete)] <- 0 #Makes values that are N/A 0 so it can be processed

# Order clusters by male percentage
order_vector <- order(male_percents_complete, decreasing = TRUE)
male_order <- all_clusters[order_vector]

# Set new levels for plotting
percent_df$type <- factor(percent_df$type, levels = male_order)
male_order

# Plot
ggplot(percent_df, aes(x = type, y = percent, fill = sex)) + geom_bar(stat = "identity", width=1) + scale_fill_manual(values=c("M"="#0095FF", "F"="#FF6B9D")) + labs(title = "Cell-type sex proportions", x = "Neuron-type (ordered by Male %)", y = "Percent", fill = "Sex") + theme_minimal() + theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 0.5))

