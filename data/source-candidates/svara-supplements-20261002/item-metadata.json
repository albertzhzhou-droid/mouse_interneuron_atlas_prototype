{"objectId":"item_3055210","versionNumber":7,"modificationDate":"2023-07-01T23:17:47.448+00:00","versionState":"RELEASED","versionPid":"hdl:21.11116/0000-000D-6436-6","modifier":{"objectId":"user_3348973"},"lastModificationDate":"2023-07-01T23:17:47.448+00:00","publicState":"RELEASED","objectPid":"hdl:21.11116/0000-0003-9C58-B","creator":{"objectId":"user_1140582"},"context":{"objectId":"ctx_1139630","name":"Publications of the MPI of Neurobiology","lastModificationDate":"2023-05-10T07:17:42.310+00:00","creationDate":"2011-09-30T09:47:12.185+00:00","creator":{"objectId":"user_user42"},"modifier":{"objectId":"user_user42"}},"creationDate":"2019-05-16T11:49:11.444+00:00","latestRelease":{"objectId":"item_3055210","versionNumber":7,"modificationDate":"2023-07-01T23:17:47.448+00:00","versionState":"RELEASED","versionPid":"hdl:21.11116/0000-000D-6436-6","modifier":{"objectId":"user_3348973"}},"latestVersion":{"objectId":"item_3055210","versionNumber":7,"modificationDate":"2023-07-01T23:17:47.448+00:00","versionState":"RELEASED","versionPid":"hdl:21.11116/0000-000D-6436-6","modifier":{"objectId":"user_3348973"}},"localTags":[],"metadata":{"title":"Volume EM reconstruction of spinal cord reveals wiring specificity in speed-related motor circuits","creators":[{"person":{"givenName":"Fabian N.","familyName":"Svara","organizations":[{"identifier":"ou_1128546","name":"Department: Electrons-Photons-Neurons / Denk, MPI of Neurobiology, Max Planck Society","identifierPath":["ou_1128546","ou_1110547","ou_persistent13"]}],"identifier":{"id":"/persons/resource/persons118241","type":"CONE"}},"role":"AUTHOR","type":"PERSON"},{"person":{"givenName":"Jörgen","familyName":"Kornfeld","organizations":[{"identifier":"ou_1128546","name":"Department: Electrons-Photons-Neurons / Denk, MPI of Neurobiology, Max Planck Society","identifierPath":["ou_1128546","ou_1110547","ou_persistent13"]}],"identifier":{"id":"/persons/resource/persons125729","type":"CONE"}},"role":"AUTHOR","type":"PERSON"},{"person":{"givenName":"Winfried","familyName":"Denk","organizations":[{"identifier":"ou_1128546","name":"Department: Electrons-Photons-Neurons / Denk, MPI of Neurobiology, Max Planck Society","identifierPath":["ou_1128546","ou_1110547","ou_persistent13"]}],"identifier":{"id":"/persons/resource/persons128986","type":"CONE"}},"role":"AUTHOR","type":"PERSON"},{"person":{"givenName":"Johann H.","familyName":"Bollmann","organizations":[{"identifier":"ou_1128546","name":"Department: Electrons-Photons-Neurons / Denk, MPI of Neurobiology, Max Planck Society","identifierPath":["ou_1128546","ou_1110547","ou_persistent13"]}],"identifier":{"id":"/persons/resource/persons267496","type":"CONE"}},"role":"AUTHOR","type":"PERSON"}],"datePublishedInPrint":"2018-06-05","genre":"ARTICLE","identifiers":[{"id":"000434982000011","type":"ISI"},{"id":"10.1016/j.celrep.2018.05.023","type":"DOI"}],"reviewMethod":"PEER","sources":[{"title":"Cell Reports","alternativeTitles":[{"value":"Cell Rep","type":"ABBREVIATION"}],"volume":"23","issue":"10","startPage":"2942","endPage":"2954","publishingInfo":{"place":"Maryland Heights, MO ","publisher":"Cell Press"},"identifiers":[{"id":"2211-1247","type":"ISSN"},{"id":"/journals/resource/2211-1247","type":"CONE"}],"genre":"JOURNAL"}],"freeKeywords":"central pattern generator; locomotion; motor control; motor neuron; neural circuit; recruitment; size principle; spinal cord; swimming; zebrafish","abstracts":[{"value":"Spinal interneurons coordinate the activity of motoneurons to generate the spatiotemporal patterns of muscle contractions required for vertebrate locomotion. It is controversial to what degree the orderly, gradual recruitment of motoneurons is determined by biophysical differences among them rather than by specific connections from presynaptic interneurons to subsets of motoneurons. To answer this question, we mapped all connections from two types of interneurons onto all motoneurons in a larval zebrafish spinal cord hemisegment, using serial block-face electron microscopy (SBEM). We found specific synaptic connectivity from dorsal but not from ventral excitatory ipsilateral interneurons, with large motoneurons, active only when strong force is required, receiving specific inputs from dorsally located interneurons, active only during fast swims. By contrast, the connectivity between inhibitory commissural interneurons and motoneurons lacks any discernible pattern. The wiring pattern is consistent with a recruitment mechanism that depends to a considerable extent on specific connectivity."}]},"files":[{"objectId":"file_3055224","name":"1-s2.0-S2211124718307563-main.pdf","lastModificationDate":"2023-07-01T23:17:45.137+00:00","creationDate":"2019-05-16T12:19:15.272+00:00","creator":{"objectId":"user_1140582"},"visibility":"PUBLIC","pid":"hdl:21.11116/0000-0003-9C5A-9","content":"/rest/items/item_3055210_7/component/file_3055224/content","storage":"INTERNAL_MANAGED","checksum":"ee130edf30fc2f5f491ac0a15ca9c08a","checksumAlgorithm":"MD5","mimeType":"application/pdf","size":4072309,"metadata":{"title":"1-s2.0-S2211124718307563-main.pdf","contentCategory":"publisher-version","formats":[{"value":"application/pdf","type":"dcterms:IMT"}],"size":0,"rights":"© 2018 The Author(s).","license":"http://creativecommons.org/licenses/by/4.0/","oaStatus":"NOT_SPECIFIED"}},{"objectId":"file_3055225","name":"1-s2.0-S2211124718307563-mmc1.pdf","lastModificationDate":"2023-07-01T23:17:45.137+00:00","creationDate":"2019-05-16T12:19:15.272+00:00","creator":{"objectId":"user_1140582"},"visibility":"PUBLIC","pid":"hdl:21.11116/0000-0003-9C5B-8","content":"/rest/items/item_3055210_7/component/file_3055225/content","storage":"INTERNAL_MANAGED","checksum":"358bfac0f23bffc63d680c3c491e20e0","checksumAlgorithm":"MD5","mimeType":"application/pdf","size":646863,"metadata":{"title":"1-s2.0-S2211124718307563-mmc1.pdf","contentCategory":"supplementary-material","formats":[{"value":"application/pdf","type":"dcterms:IMT"}],"size":0,"oaStatus":"N