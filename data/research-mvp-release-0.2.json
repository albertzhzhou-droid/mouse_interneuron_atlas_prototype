  "evidenceStatements": [
    {"id": "P02-N01", "sourceId": "SRC-P02", "kind": "negative_finding", "text": "Retrograde brainstem labeling remained reduced by 81-100% after double lesions."},
    {"id": "P02-B01", "sourceId": "SRC-P02", "kind": "boundary", "text": "The staggered design did not reproduce one anatomically complete lesion at one level."},
    {"id": "P02-B02", "sourceId": "SRC-P02", "kind": "boundary", "text": "Clinical efficacy in heterogeneous human SCI is not established."},
    {"id": "P03-N01", "sourceId": "SRC-P03", "kind": "negative_finding", "text": "Before injury, fundamental rhythm and interlimb coordination were largely intact, but subtle stance and foot-placement differences remained."},
    {"id": "P03-B01", "sourceId": "SRC-P03", "kind": "boundary", "text": "dI3 activation alone was not tested as sufficient."},
    {"id": "P03-B02", "sourceId": "SRC-P03", "kind": "boundary", "text": "An equivalent dI3 role in humans is not established."},
    {"id": "P05-N01", "sourceId": "SRC-P05", "kind": "null_result", "text": "CLP290 did not produce significant recovery during the first two to three weeks."},
    {"id": "P05-N02", "sourceId": "SRC-P05", "kind": "null_result", "text": "Bumetanide did not significantly improve stepping."},
    {"id": "P05-N03", "sourceId": "SRC-P05", "kind": "negative_finding", "text": "CLP290 failed after complete T8 transection."},
    {"id": "P05-N04", "sourceId": "SRC-P05", "kind": "null_result", "text": "CLP290 did not increase descending or propriospinal axon growth."},
    {"id": "P05-N05", "sourceId": "SRC-P05", "kind": "null_result", "text": "The prolonged latency of cortical-evoked muscle responses was unchanged."},
    {"id": "P05-N06", "sourceId": "SRC-P05", "kind": "negative_finding", "text": "Residual tibialis anterior and gastrocnemius coactivation indicated suboptimal coordination."},
    {"id": "P05-B01", "sourceId": "SRC-P05", "kind": "boundary", "text": "The data do not support generalized disinhibition or efficacy after every injury type."},
    {"id": "P05-B02", "sourceId": "SRC-P05", "kind": "boundary", "text": "Human efficacy of CLP290 is not established."},
    {"id": "P08-N01", "sourceId": "SRC-P08", "kind": "negative_finding", "text": "Adult vGAT attenuation yielded variable, incomplete and poorly coordinated stepping."},
    {"id": "P08-N02", "sourceId": "SRC-P08", "kind": "null_result", "text": "Training alone did not significantly improve locomotor ability."},
    {"id": "P08-L01", "sourceId": "SRC-P08", "kind": "limitation", "text": "Behavioral testing was not blinded."},
    {"id": "P08-B01", "sourceId": "SRC-P08", "kind": "boundary", "text": "Neonatal and adult injury conditions must remain separate and do not establish complete recovery or a human sensitive period."},
    {"id": "P08-B02", "sourceId": "SRC-P08", "kind": "boundary", "text": "The study does not support suppressing all inhibitory signaling."},
    {"id": "P09-N01", "sourceId": "SRC-P09", "kind": "null_result", "text": "The same inactivation or ablation approaches produced no detected basic-walking deficit in healthy mice."},
    {"id": "P09-L01", "sourceId": "SRC-P09", "kind": "limitation", "text": "The human cohort was a first-in-human safety and feasibility cohort without a randomized control group."},
    {"id": "P09-B01", "sourceId": "SRC-P09", "kind": "boundary", "text": "Mouse cell-type causality does not identify the causal substrate in human participants."},
    {"id": "P09-B02", "sourceId": "SRC-P09", "kind": "boundary", "text": "Efficacy in a randomized human comparison is not established."},
    {"id": "P14-C01", "sourceId": "SRC-P14", "kind": "counterfinding", "text": "Repeated V3 stimulation reduced subsequent spasm expression."},
    {"id": "P14-B01", "sourceId": "SRC-P14", "kind": "boundary", "text": "V3 neurons are not established as the sole generator of spasticity."},
    {"id": "P14-B02", "sourceId": "SRC-P14", "kind": "boundary", "text": "V3 activation does not establish useful locomotor recovery."},
    {"id": "P14-B03", "sourceId": "SRC-P14", "kind": "boundary", "text": "Clinical safety of V3 silencing is not established."},
    {"id": "P16-N01", "sourceId": "SRC-P16", "kind": "null_result", "text": "Chemogenetic inhibition left resting breathing in healthy mice largely intact."},
    {"id": "P16-B01", "sourceId": "SRC-P16", "kind": "boundary", "text": "Durable respiratory recovery without stimulation is not established."},
    {"id": "P16-B02", "sourceId": "SRC-P16", "kind": "boundary", "text": "Equivalence to V2a populations studied in locomotion is not established."},
    {"id": "P16-B03", "sourceId": "SRC-P16", "kind": "boundary", "text": "Clinical efficacy is not established."}
