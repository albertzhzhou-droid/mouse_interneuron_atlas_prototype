{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/public-source-assertion-provenance-0.1.json",
  "title": "OHRI public-source assertion provenance composer 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "catalogReleaseId", "admissionServiceReleaseId", "queueItemId", "title", "assertionSourceStates", "subjectKinds", "evidenceLocatorKinds", "claimScopes", "nonPromotion", "localRuntime", "scientificBoundary", "nextQueueItems"],
  "properties": {
    "releaseId": {"const": "ohri-public-source-assertion-provenance-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "catalogReleaseId": {"const": "ohri-mouse-interneuron-public-data-workbench-0.4.0"},
    "admissionServiceReleaseId": {"const": "ohri-public-source-release-admission-service-0.1.0"},
    "queueItemId": {"const": "UPG-018"},
    "title": {"type": "string", "minLength": 1},
    "assertionSourceStates": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["publisher_asserted", "curator_transcribed", "unresolved"]}},
    "subjectKinds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["declared_unacquired_source_object", "unknown_source_object"]}},
    "evidenceLocatorKinds": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["publisher_object_url", "dataset_landing_page", "source_metadata_field", "curator_note"]}},
    "claimScopes": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+$"}},
    "nonPromotion": {"type": "object", "additionalProperties": false, "required": ["admissionDecision", "verificationStatus", "blockedActions", "forbiddenAssertionStates"], "properties": {"admissionDecision": {"const": "not_admitted_pending_curator_object_and_rights_review"}, "verificationStatus": {"const": "not_locally_verified"}, "blockedActions": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+$"}}, "forbiddenAssertionStates": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+$"}}}},
    "localRuntime": {"type": "object", "additionalProperties": false, "required": ["networkRequests", "sourceFileDownload", "sourceFileUpload", "persistentStorage", "output"], "properties": {"networkRequests": {"const": false}, "sourceFileDownload": {"const": false}, "sourceFileUpload": {"const": false}, "persistentStorage": {"const": "none"}, "output": {"const": "browser_download_of_assertion_provenance_receipt_json"}}},
    "scientificBoundary": {"type": "string", "minLength": 1},
    "nextQueueItems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^UPG-[0-9]{3}$"}}
  }
}
