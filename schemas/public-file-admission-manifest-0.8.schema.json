{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/public-file-admission-manifest-0.8.json",
  "title": "OHRI specimen-aware Cano-Gomez public file-admission manifest 0.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "manifestId", "sourceId", "dataset", "reviewDate", "specimens", "files", "admissionDecision"],
  "properties": {
    "formatVersion": {"const": "0.8.0"},
    "manifestId": {"type": "string", "pattern": "^PFM-CANOGOMEZ-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceId": {"const": "PDS-CANOGOMEZ-2026"},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["accession", "version", "landingPageUrl", "preprintStatus", "rightsDecision"], "properties": {"accession": {"const": "GSE318731 / BIL DOI 10.35077/g.1196"}, "version": {"type": "string", "minLength": 1}, "landingPageUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "preprintStatus": {"const": "preprint_resource"}, "rightsDecision": {"const": "recorded_for_file"}}},
    "reviewDate": {"type": "string", "format": "date"},
    "specimens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/specimen"}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "admissionDecision": {"const": "metadata_only_not_downloaded_not_registered"}
  },
  "$defs": {
    "sourceChecksum": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value", "provenance"], "properties": {"algorithm": {"enum": ["sha1", "sha256"]}, "value": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"}, "provenance": {"const": "source_metadata"}}, "allOf": [{"if": {"properties": {"algorithm": {"const": "sha1"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}}, {"if": {"properties": {"algorithm": {"const": "sha256"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}]},
    "specimen": {"type": "object", "additionalProperties": false, "required": ["specimenId", "animalId", "sex", "spinalRegion", "assay", "sourceFrame", "coordinateUnit", "axisOrder", "axisDirection", "coordinateOrigin", "pixelOrVoxelScale", "missingReason"], "properties": {"specimenId": {"type": "string", "minLength": 1}, "animalId": {"type": ["string", "null"]}, "sex": {"enum": ["female", "male", "not_reported"]}, "spinalRegion": {"type": "string", "minLength": 1}, "assay": {"type": "string", "minLength": 1}, "sourceFrame": {"type": "string", "minLength": 1}, "coordinateUnit": {"type": ["string", "null"]}, "axisOrder": {"type": ["string", "null"]}, "axisDirection": {"type": ["string", "null"]}, "coordinateOrigin": {"type": ["string", "null"]}, "pixelOrVoxelScale": {"type": ["string", "null"]}, "missingReason": {"type": ["string", "null"]}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["id", "stableName", "sourceUrl", "bytes", "format", "modality", "specimenIds", "sourceChecksum", "localSha256", "rightsDecision"], "properties": {"id": {"type": "string", "minLength": 1}, "stableName": {"type": "string", "minLength": 1}, "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "bytes": {"type": "integer", "minimum": 1}, "format": {"type": "string", "minLength": 1}, "modality": {"enum": ["Xenium spatial transcriptomics", "snMultiome"]}, "specimenIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "sourceChecksum": {"$ref": "#/$defs/sourceChecksum"}, "localSha256": {"const": null}, "rightsDecision": {"const": "recorded_for_file"}}}
  }
}
