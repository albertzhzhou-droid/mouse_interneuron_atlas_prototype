        "scope": { "enum": ["project", "scientificAuthority"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
        "purpose": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
