      "type": "object",
      "additionalProperties": false,
      "required": ["path", "releaseId", "bytes", "fileSha256", "contentSha256"],
      "properties": {
        "path": { "const": "data/research-iteration-manifest-2.34.json" },
        "releaseId": { "const": "ohri-mouse-interneuron-research-iteration-2.34.0" },
        "bytes": { "const": 125197 },
        "fileSha256": { "const": "76ead4e29455c8e9250f294afa4e78b6a72bb76709115d15954564545bb43d1e" },
