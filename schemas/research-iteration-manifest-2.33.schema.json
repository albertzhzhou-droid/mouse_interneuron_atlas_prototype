  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authoritativeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "path", "purpose", "bytes", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["project", "scientificAuthority"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
        "purpose": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "micronsSourceNativeClipping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId", "releaseId", "upgradeId", "authority", "sourceCellRootId",
