  "properties": {
    "manifestSchemaVersion": { "const": "2.33.0" },
    "releaseId": { "const": "ohri-mouse-interneuron-research-iteration-2.33.0" },
    "releaseDate": { "const": "2026-09-01" },
    "releaseStatus": { "const": "localhost_research_iteration" },
    "application": {
      "const": { "name": "ohri-mouse-interneuron-atlas-prototype", "version": "2.33.0-research.1" }
