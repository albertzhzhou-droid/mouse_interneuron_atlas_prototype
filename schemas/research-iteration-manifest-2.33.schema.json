    "baseResearchRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "schemaVersion", "note"],
      "properties": {
        "releaseId": { "const": "ohri-mouse-interneuron-research-mvp-candidate-0.2.0" },
        "schemaVersion": { "const": "0.2.0" },
        "note": { "type": "string", "minLength": 100 }
      }
    },
    "parentIterationManifest": {
      "const": {
        "path": "data/research-iteration-manifest-2.32.json",
        "releaseId": "ohri-mouse-interneuron-research-iteration-2.32.0",
        "bytes": 98357,
        "fileSha256": "eaacd5bb0acae3c704e24ac2c1ffa4ef508bc5491155898bec6f28a825ea5e77",
        "contentSha256": "4b0ed4508655553736b656f7a72a6d2e869218e0a4eff886811c7f0f15e113a2"
      }
    },
    "inputRoots": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["locator", "policy"],
        "properties": {
          "locator": { "type": "string", "minLength": 1 },
          "policy": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authoritativeInputs": {
      "type": "array",
      "minItems": 75,
      "maxItems": 75,
      "items": { "$ref": "#/$defs/authoritativeInput" }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "inputCount"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "inputCount": { "const": 75 }
      }
    },
    "registrations": { "const": { "count": 0, "records": [] } },
    "exactReferences": {
      "type": "object",
      "minProperties": 14,
      "required": ["researchExplorerVisualIntegrity", "uiKnowledgeAndTopologyIntegrity", "micronsClippingAndSourceRecordDeltaIntegrity"],
      "properties": {
        "researchExplorerVisualIntegrity": { "type": "object" },
        "uiKnowledgeAndTopologyIntegrity": { "type": "object" },
        "micronsClippingAndSourceRecordDeltaIntegrity": { "$ref": "#/$defs/iterationIntegrity" }
      },
      "additionalProperties": { "type": "object" }
    },
    "registrySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalSourcePackageCount", "canonicalRecordSetCount", "bundledExactRosterCount", "researchUpgradeCount", "sourceRegistryReceipt", "upgradeRegistryReceipt", "crossSourceIdentityCount", "registrationCount", "renderedInternalPrimitiveCount"],
      "properties": {
        "canonicalSourcePackageCount": { "const": 24 },
        "canonicalRecordSetCount": { "const": 28 },
        "bundledExactRosterCount": { "const": 7 },
        "researchUpgradeCount": { "type": "integer", "minimum": 149 },
        "sourceRegistryReceipt": { "$ref": "#/$defs/authoritativeInput" },
        "upgradeRegistryReceipt": { "$ref": "#/$defs/authoritativeInput" },
        "crossSourceIdentityCount": { "const": 0 },
        "registrationCount": { "const": 0 },
        "renderedInternalPrimitiveCount": { "const": 0 }
      }
    },
    "scientificBoundaries": {
      "type": "object",
      "minProperties": 17,
      "required": ["researchExplorerVisualIntegrity", "uiKnowledgeAndTopologyIntegrity", "micronsClippingAndSourceRecordDeltaIntegrity"],
      "properties": {
        "researchExplorerVisualIntegrity": { "type": "string", "minLength": 50 },
        "uiKnowledgeAndTopologyIntegrity": { "type": "string", "minLength": 200 },
        "micronsClippingAndSourceRecordDeltaIntegrity": { "type": "string", "minLength": 300 }
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "boolean" }
        ]
      }
    },
    "manifestContentSha256": { "$ref": "#/$defs/sha256" }
