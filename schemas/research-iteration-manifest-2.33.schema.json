        "repairCount", "resamplingCount", "generatedGeometryCount", "geometryMutationCount",
        "joinCount", "registrationCount", "measurementClaim", "membraneClaim",
        "spinalInternalStructureClaim"
      ],
      "properties": {
        "contractId": { "const": "microns-source-native-clipping-0.1" },
        "releaseId": { "const": "ohri-microns-source-native-clipping-0.1.0" },
        "upgradeId": { "const": "UPG-166" },
        "authority": { "const": "DER_DISPLAY_OPERATION_ON_OBS_EM_SEGMENTATION" },
        "sourceCellRootId": { "const": "648518346349516051" },
        "sourceLinkedNucleusId": { "const": "4309" },
        "nativeFrame": { "const": "MICrONS_Phase1_aligned_EM_native" },
        "nativeUnits": { "const": "nanometre" },
        "region": { "const": "visual cortex layer 2/3" },
        "regionRelationshipToProject": { "const": "cross_region_not_spinal_cord" },
        "axisCount": { "const": 3 },
        "defaultState": {
          "const": { "enabled": false, "axis": "z", "positionNanometre": 80240, "keepSide": "positive" }
        },
        "cellVertexCount": { "const": 372382 },
        "cellTriangleCount": { "const": 704444 },
        "nucleusVertexCount": { "const": 12682 },
        "nucleusTriangleCount": { "const": 23344 },
        "contractReceipt": { "$ref": "#/$defs/receipt" },
        "schemaReceipt": { "$ref": "#/$defs/receipt" },
        "runtimeReceipt": { "$ref": "#/$defs/receipt" },
        "validatorReceipt": { "$ref": "#/$defs/receipt" },
        "testReceipt": { "$ref": "#/$defs/receipt" },
        "panelReceipt": { "$ref": "#/$defs/receipt" },
        "sceneIntegrationReceipt": { "$ref": "#/$defs/receipt" },
        "atlasStateIntegrationReceipt": { "$ref": "#/$defs/receipt" },
        "importProvenanceReceipt": { "$ref": "#/$defs/receipt" },
        "importProvenanceTestReceipt": { "$ref": "#/$defs/receipt" },
        "atlasTypesReceipt": { "$ref": "#/$defs/receipt" },
        "sourceBufferMutation": { "const": false },
        "cellClippingPlaneCountWhenEnabled": { "const": 1 },
        "nucleusClippingPlaneCount": { "const": 0 },
        "capPrimitiveCount": { "const": 0 },
        "repairCount": { "const": 0 },
        "resamplingCount": { "const": 0 },
        "generatedGeometryCount": { "const": 0 },
        "geometryMutationCount": { "const": 0 },
        "joinCount": { "const": 0 },
        "registrationCount": { "const": 0 },
        "measurementClaim": { "const": false },
        "membraneClaim": { "const": false },
        "spinalInternalStructureClaim": { "const": false }
      }
    },
    "sourceRecordDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId", "upgradeId", "mode", "authority", "relationshipStatus", "oldRecordId",
        "currentRecordId", "uiWhitelistedRowCount", "uiWhitelistedRowIds",
        "demonstrationWhitelistedRowCount", "demonstrationSharedRowCount", "demonstrationChangedRowCount",
        "unlistedFieldCountInspected", "changedRowIds", "sharedRowIds", "runtimeReceipt",
        "inspectorReceipt", "testReceipt", "typeAtlasIntegrationReceipt",
