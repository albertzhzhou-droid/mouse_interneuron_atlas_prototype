{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/research-iteration-manifest-2.33.schema.json",
  "title": "OHRI mouse interneuron research iteration manifest 2.33",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "releaseId",
    "releaseDate",
    "releaseStatus",
    "application",
    "baseResearchRelease",
    "authoritativeInputs",
    "inputRoots",
    "integrity",
    "registrations",
    "exactReferences",
    "registrySummary",
    "scientificBoundaries",
    "manifestContentSha256",
    "parentIterationManifest"
