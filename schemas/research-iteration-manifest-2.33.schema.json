        "crossSourceSameTypeIdentityCount": { "const": 0 },
        "admittedGeometryPrimitiveCount": { "const": 0 },
        "generatedBiologicalGeometryPrimitiveCount": { "const": 0 },
        "joinCount": { "const": 0 },
        "registrationCount": { "const": 0 },
        "measurementUse": { "const": "forbidden" }
