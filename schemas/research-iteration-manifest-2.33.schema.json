        "upgradeId": { "const": "UPG-167" },
        "mode": { "const": "EXACT_WHITELISTED_DISPLAY_STRING_DELTA" },
        "authority": { "const": "DISPLAY_ONLY" },
        "relationshipStatus": { "const": "not_established" },
        "oldRecordId": { "const": "alkaslasi-2021:GSE167597:I1" },
        "currentRecordId": { "const": "alkaslasi-2021:GSE167597:I2" },
        "uiWhitelistedRowCount": { "const": 24 },
        "uiWhitelistedRowIds": {
          "const": [
            "parent-source", "namespace", "record-kind", "observation-unit",
            "assignment-authority", "cell-roster", "source-label", "region",
            "transmitter", "markers", "life-stage", "spinal-scope", "major-type",
            "sampling-count", "putative-assignment", "morphology", "cell-coordinates",
            "sci-context", "atlas-registration", "electrophysiology", "projection-target",
            "synaptic-connectivity", "internal-structure", "same-cell-link"
