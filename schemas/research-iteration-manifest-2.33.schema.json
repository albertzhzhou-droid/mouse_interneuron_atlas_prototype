        },
        "demonstrationWhitelistedRowCount": { "const": 8 },
        "demonstrationSharedRowCount": { "const": 5 },
        "demonstrationChangedRowCount": { "const": 3 },
        "unlistedFieldCountInspected": { "const": 0 },
        "changedRowIds": {
          "const": ["sampling-count", "markers", "region-membership"]
