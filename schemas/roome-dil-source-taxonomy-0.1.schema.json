{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/roome-dil-source-taxonomy-0.1.schema.json",
  "title": "Roome 2026 source-local refined dIL taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "releaseDate", "title", "source", "scope", "denominatorBoundary", "signatureMethod", "derivation", "familySummaries", "excludedDevelopmentalLabels", "profiles", "anomalies", "globalMissingEvidence", "joinPolicy", "hardBoundaries"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "releaseId": { "const": "ohri-roome-dil-source-taxonomy-0.1.0" },
    "releaseDate": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 40 },
    "source": { "type": "object", "required": ["publication", "geo", "code", "tables"], "properties": { "publication": { "type": "object" }, "geo": { "type": "object" }, "code": { "type": "object" }, "tables": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/table" } } } },
    "scope": { "type": "object", "required": ["species", "taxonId", "lifeStages", "sampledRegions", "biologicalLitterPoolCount", "retainedTechnicalOutputCount", "postFilterCellCount", "neuronCount", "refinedDilCellCount", "familyCount", "refinedTypeCount", "displayedProfileCount", "admittedGeometryCount", "admittedInternalStructureCount", "sameCellCrossModalJoinCount", "projectRegistrationCount"], "properties": { "species": { "const": "Mus musculus" }, "taxonId": { "const": "NCBITaxon:10090" }, "lifeStages": { "type": "array", "minItems": 2 }, "sampledRegions": { "type": "array", "minItems": 3 }, "biologicalLitterPoolCount": { "const": 15 }, "embryosPerPoolMinimum": { "const": 3 }, "embryosPerPoolMaximum": { "const": 10 }, "attemptedChromiumReactionCount": { "const": 30 }, "excludedChromiumReactionCount": { "const": 1 }, "retainedTechnicalOutputCount": { "const": 29 }, "preFilterCellCount": { "const": 337422 }, "postFilterCellCount": { "const": 195146 }, "neuronCount": { "const": 94048 }, "refinedDilCellCount": { "const": 61444 }, "familyCount": { "const": 12 }, "refinedTypeCount": { "const": 157 }, "displayedProfileCount": { "const": 157 }, "nonRosterDevelopmentalLabelCount": { "const": 2 }, "admittedGeometryCount": { "const": 0 }, "admittedInternalStructureCount": { "const": 0 }, "sameCellCrossModalJoinCount": { "const": 0 }, "projectRegistrationCount": { "const": 0 } } },
    "denominatorBoundary": { "type": "string", "minLength": 120 },
    "signatureMethod": { "type": "object", "required": ["label", "sourceRowsPerLabel", "adjustedPValueMaximum", "avgLog2FcDirection", "pct1Minimum", "prevalenceDeltaMinimum", "excludeQuarantinedGeneCells", "deterministicSort", "displayedFeatureCountPerProfile", "interpretationBoundary"], "properties": { "label": { "const": "positive differential features meeting display thresholds" }, "sourceRowsPerLabel": { "const": 100 }, "sourceClusterCount": { "const": 159 }, "exactRosterClusterCount": { "const": 157 }, "adjustedPValueMaximum": { "const": 0.05 }, "avgLog2FcDirection": { "const": "greater_than_zero" }, "pct1Minimum": { "const": 0.25 }, "prevalenceDeltaMinimum": { "const": 0.1 }, "excludeQuarantinedGeneCells": { "const": true }, "deterministicSort": { "const": ["pct.1_minus_pct.2_desc", "avg_log2FC_desc", "gene_asc"] }, "displayedFeatureCountPerProfile": { "const": 6 }, "interpretationBoundary": { "type": "string", "minLength": 80 } } },
    "derivation": { "type": "object", "required": ["fullFeatureEvidenceReleaseId", "fullFeatureEvidencePath", "fullFeatureEvidenceBytes", "fullFeatureEvidenceSha256", "sourceRowCount", "retainedTextGeneRowCount", "quarantinedGeneCellCount", "compactDisplayFeatureCount", "sourceObjectsBundled", "derivedFactualContractsBundled"], "properties": { "fullFeatureEvidenceReleaseId": { "const": "ohri-roome-dil-differential-features-0.1.0" }, "fullFeatureEvidencePath": { "const": "data/roome-dil-differential-features-0.1.json" }, "fullFeatureEvidenceBytes": { "type": "integer", "minimum": 1 }, "fullFeatureEvidenceSha256": { "$ref": "#/$defs/sha256" }, "sourceRowCount": { "const": 15900 }, "retainedTextGeneRowCount": { "const": 15874 }, "quarantinedGeneCellCount": { "const": 26 }, "compactDisplayFeatureCount": { "const": 942 }, "sourceObjectsBundled": { "const": false }, "derivedFactualContractsBundled": { "const": true } } },
    "familySummaries": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["family", "refinedTypeCount", "cellCount"], "properties": { "family": { "type": "string", "pattern": "^dIL[AB][1-6]$" }, "refinedTypeCount": { "type": "integer", "minimum": 1 }, "cellCount": { "type": "integer", "minimum": 1 } } } },
    "excludedDevelopmentalLabels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["label", "status", "sourceRowCount", "displayBoundary"], "properties": { "label": { "type": "string" }, "status": { "const": "developmental_state_outside_exact_s6_roster" }, "sourceRowCount": { "const": 100 }, "displayBoundary": { "type": "string", "minLength": 50 } } } },
    "profiles": { "type": "array", "minItems": 157, "maxItems": 157, "items": { "$ref": "#/$defs/profile" } },
    "anomalies": { "type": "object", "required": ["excelCoercedGeneCellCount", "excelCoercedGeneCells", "interpretationBoundary"], "properties": { "excelCoercedGeneCellCount": { "const": 26 }, "excelCoercedGeneCells": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "$ref": "#/$defs/quarantine" } }, "interpretationBoundary": { "type": "string", "minLength": 80 } } },
    "globalMissingEvidence": { "$ref": "#/$defs/missingEvidence" },
    "joinPolicy": { "type": "object", "required": ["scrnaToXeniumSameCellJoin", "crossSourceTypeIdentity", "typeToMorphologyJoin", "typeToInternalStructureJoin", "xeniumCoordinateAuthority", "projectAtlasTransform"], "properties": { "scrnaToXeniumSameCellJoin": { "const": "forbidden_no_same_cell_relationship" }, "crossSourceTypeIdentity": { "const": "not_established" }, "typeToMorphologyJoin": { "const": "not_established" }, "typeToInternalStructureJoin": { "const": "not_established" }, "xeniumCoordinateAuthority": { "const": "source_local_2d_predicted_label_only" }, "projectAtlasTransform": { "type": "null" } } },
    "hardBoundaries": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 50 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "table": { "type": "object", "required": ["id", "fileName", "sheet", "range", "bytes", "md5", "sha256", "url", "role", "sourceFileBundled", "accessMode", "rightsStatus", "license", "licenseSource"], "properties": { "id": { "type": "string" }, "fileName": { "type": "string" }, "sheet": { "type": "string" }, "range": { "type": "string" }, "bytes": { "type": "integer" }, "md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "sha256": { "$ref": "#/$defs/sha256" }, "url": { "type": "string", "format": "uri" }, "role": { "type": "string" }, "sourceFileBundled": { "const": false }, "accessMode": { "const": "link_only" }, "rightsStatus": { "const": "licensed" }, "license": { "const": "CC BY" }, "licenseSource": { "type": "string" } } },
    "displayFeature": { "type": "object", "additionalProperties": false, "required": ["rank", "gene", "sourceRow", "sourceRange", "pValue", "avgLog2Fc", "pct1", "pct2", "prevalenceDelta", "adjustedPValue"], "properties": { "rank": { "type": "integer", "minimum": 1, "maximum": 6 }, "gene": { "type": "string", "minLength": 1 }, "sourceRow": { "type": "integer", "minimum": 2, "maximum": 15901 }, "sourceRange": { "type": "string" }, "pValue": { "type": "number", "minimum": 0 }, "avgLog2Fc": { "type": "number", "exclusiveMinimum": 0 }, "pct1": { "type": "number", "minimum": 0.25, "maximum": 1 }, "pct2": { "type": "number", "minimum": 0, "maximum": 1 }, "prevalenceDelta": { "type": "number", "minimum": 0.1, "maximum": 1 }, "adjustedPValue": { "type": "number", "minimum": 0, "maximum": 0.05 } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["sourceRow", "sourceRange", "sourceLocalLabel", "family", "transmitterClass", "frequency", "percentOfDil", "meanGenesPerCell", "meanSilhouetteScore", "meanLisiScore", "id", "differentialFeatureAudit", "displayFeatures", "displayFeatureLabel", "sourceLocators", "missingEvidence"], "properties": { "sourceRow": { "type": "integer", "minimum": 2, "maximum": 158 }, "sourceRange": { "type": "string" }, "sourceLocalLabel": { "type": "string", "pattern": "^dIL[AB]" }, "family": { "type": "string", "pattern": "^dIL[AB][1-6]$" }, "transmitterClass": { "enum": ["inhibitory_family_context", "excitatory_family_context"] }, "frequency": { "type": "integer", "minimum": 1 }, "percentOfDil": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "meanGenesPerCell": { "type": "number", "exclusiveMinimum": 0 }, "meanSilhouetteScore": { "type": "number" }, "meanLisiScore": { "type": "number", "minimum": 1 }, "id": { "type": "string", "pattern": "^roome-2026:GSE291462:dIL" }, "differentialFeatureAudit": { "type": "object", "required": ["sourceRowCount", "retainedTextGeneRowCount", "quarantinedGeneRowCount", "positiveDisplayCandidateCount", "canonicalSourceRowsSha256"], "properties": { "sourceRowCount": { "const": 100 }, "retainedTextGeneRowCount": { "type": "integer", "minimum": 98, "maximum": 100 }, "quarantinedGeneRowCount": { "type": "integer", "minimum": 0, "maximum": 2 }, "positiveDisplayCandidateCount": { "type": "integer", "minimum": 6, "maximum": 100 }, "canonicalSourceRowsSha256": { "$ref": "#/$defs/sha256" } } }, "displayFeatures": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/displayFeature" } }, "displayFeatureLabel": { "const": "positive differential features meeting display thresholds" }, "sourceLocators": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "string" } }, "missingEvidence": { "$ref": "#/$defs/missingEvidence" } } },
    "missingEvidence": { "type": "object", "additionalProperties": false, "required": ["morphology", "wholeCellGeometry", "axonDendriteTopology", "electrophysiology", "projectionTarget", "synapticConnectivity", "internalStructure", "atlasRegistration", "sameCellScrnaXeniumJoin", "crossSourceSameCellIdentity", "sciContext"], "properties": { "morphology": { "const": "not_measured_by_study" }, "wholeCellGeometry": { "const": "not_measured_by_study" }, "axonDendriteTopology": { "const": "not_measured_by_study" }, "electrophysiology": { "const": "not_measured_by_study" }, "projectionTarget": { "const": "not_measured_by_study" }, "synapticConnectivity": { "const": "not_measured_by_study" }, "internalStructure": { "const": "not_measured_by_study" }, "atlasRegistration": { "const": "no_admitted_transform" }, "sameCellScrnaXeniumJoin": { "const": "relationship_not_established" }, "crossSourceSameCellIdentity": { "const": "relationship_not_established" }, "sciContext": { "const": "not_measured_by_study" } } },
    "quarantine": { "type": "object", "required": ["sourceRow", "sourceCell", "cluster", "rawNumericValue", "styleIndex", "spreadsheetDisplay", "status", "interpretationBoundary"], "properties": { "sourceRow": { "type": "integer" }, "sourceCell": { "type": "string", "pattern": "^G[0-9]+$" }, "cluster": { "type": "string" }, "rawNumericValue": { "type": "string" }, "styleIndex": { "const": 2 }, "spreadsheetDisplay": { "type": "string", "format": "date" }, "status": { "const": "quarantined_excel_coercion" }, "interpretationBoundary": { "type": "string", "minLength": 80 } } }
  }
}
