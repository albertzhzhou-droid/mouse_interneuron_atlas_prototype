{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/russ-reconciliation-dossier-0.1.json",
  "title": "Russ 2021 reconciliation dossier 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "dossierDate", "sourceId", "authority", "purpose", "sourceArticle", "pinnedMarkerTable", "corrections", "reconciliationItems", "releaseDecision"],
  "properties": {
    "releaseId": {"const": "ohri-russ-reconciliation-dossier-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "dossierDate": {"type": "string", "format": "date"},
    "sourceId": {"const": "PDS-RUSS-2021"},
    "authority": {"const": "PROVENANCE_RECONCILIATION_ONLY"},
    "purpose": {"type": "string", "minLength": 1},
    "sourceArticle": {"$ref": "#/$defs/article"},
    "pinnedMarkerTable": {"type": "object", "additionalProperties": false, "required": ["title", "sourceUrl", "bytes", "sha256", "sourceFileBundled", "derivedMetadataBundled", "tableContentChangeStatedByCorrections", "boundary"], "properties": {"title": {"type": "string", "minLength": 1}, "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "bytes": {"const": 1475885}, "sha256": {"const": "a45578c893998fae42acf781c4700d162249497476b0b81149302f49929fd2e0"}, "sourceFileBundled": {"const": false}, "derivedMetadataBundled": {"const": true}, "tableContentChangeStatedByCorrections": {"const": false}, "boundary": {"type": "string", "minLength": 1}}},
    "corrections": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/correction"}},
    "reconciliationItems": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/item"}},
    "releaseDecision": {"type": "object", "additionalProperties": false, "required": ["currentStatus", "permitted", "forbidden", "nextCuratorGate"], "properties": {"currentStatus": {"const": "reconciled_provenance_no_narrow_transfer"}, "permitted": {"type": "string", "minLength": 1}, "forbidden": {"type": "string", "minLength": 1}, "nextCuratorGate": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "article": {"type": "object", "additionalProperties": false, "required": ["doi", "url", "published", "currentArticleNotice", "scope"], "properties": {"doi": {"const": "10.1038/s41467-021-25125-1"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "published": {"const": "2021-09-29"}, "currentArticleNotice": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}},
    "correction": {"type": "object", "additionalProperties": false, "required": ["id", "doi", "url", "published", "scope", "directEffectOnPinnedMarkerTable", "crosswalkDecision"], "properties": {"id": {"enum": ["COR-RUSS-2022-02", "COR-RUSS-2022-10"]}, "doi": {"enum": ["10.1038/s41467-022-28698-7", "10.1038/s41467-022-33998-z"]}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "published": {"enum": ["2022-02-18", "2022-10-19"]}, "scope": {"type": "string", "minLength": 1}, "directEffectOnPinnedMarkerTable": {"type": "string", "minLength": 1}, "crosswalkDecision": {"type": "string", "minLength": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["id", "topic", "status", "evidence", "curatorQuestion", "notEstablished"], "properties": {"id": {"type": "string", "pattern": "^REC-RUSS-[0-9]{3}$"}, "topic": {"type": "string", "minLength": 1}, "status": {"enum": ["receipt_pinned_content_not_rebundled", "context_separated", "corrected_visual_annotation"]}, "evidence": {"type": "string", "minLength": 1}, "curatorQuestion": {"type": "string", "minLength": 1}, "notEstablished": {"type": "string", "minLength": 1}}}
  }
}
