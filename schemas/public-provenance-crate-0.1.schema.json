{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/public-provenance-crate-0.1.json",
  "title": "OHRI public-source detached RO-Crate exporter contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "catalogReleaseId", "roCrateVersion", "roCrateContext", "roCrateSpecification", "packagingMode", "publicSourceIds", "localRuntime", "releaseDecision", "nextQueueItems"],
  "properties": {
    "releaseId": {"const": "ohri-public-provenance-crate-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "catalogReleaseId": {"const": "ohri-mouse-interneuron-public-data-workbench-0.4.0"},
    "roCrateVersion": {"const": "1.3"},
    "roCrateContext": {"const": "https://w3id.org/ro/crate/1.3/context"},
    "roCrateSpecification": {"const": "https://w3id.org/ro/crate/1.3"},
    "packagingMode": {"const": "detached_metadata_document"},
    "publicSourceIds": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^PDS-[A-Z0-9-]+$"}},
    "localRuntime": {"type": "object", "additionalProperties": false, "required": ["networkRequests", "sourceFileUpload", "sourceFileDownload", "persistentStorage", "localHashCalculation", "output"], "properties": {"networkRequests": {"const": false}, "sourceFileUpload": {"const": false}, "sourceFileDownload": {"const": false}, "persistentStorage": {"const": "none"}, "localHashCalculation": {"const": false}, "output": {"const": "browser_download_of_detached_ro_crate_metadata_json"}}},
    "releaseDecision": {"type": "object", "additionalProperties": false, "required": ["permitted", "blockedUntil", "scientificBoundary"], "properties": {"permitted": {"type": "string", "minLength": 1}, "blockedUntil": {"type": "string", "minLength": 1}, "scientificBoundary": {"type": "string", "minLength": 1}}},
    "nextQueueItems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^UPG-[0-9]{3}$"}}
  }
}
