    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "geo"],
      "properties": {
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "citation", "doi", "pmid", "articleUrl", "license"],
          "properties": {
            "id": {"const": "ALKASLASI-2021"},
            "citation": {"type": "string", "minLength": 100},
            "doi": {"const": "10.1038/s41467-021-22691-2"},
            "pmid": {"const": "33931636"},
            "articleUrl": {"const": "https://www.nature.com/articles/s41467-021-22691-2"},
            "license": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "url", "appliesTo", "sourceLocatorIds", "rightsBoundary"],
              "properties": {
                "id": {"const": "CC-BY-4.0"},
                "url": {"const": "https://creativecommons.org/licenses/by/4.0/"},
                "appliesTo": {"const": "article_and_article_source_data_subject_to_third_party_exceptions"},
                "sourceLocatorIds": {"$ref": "#/$defs/nonEmptyStringArray"},
                "rightsBoundary": {"type": "string", "minLength": 100}
              }
