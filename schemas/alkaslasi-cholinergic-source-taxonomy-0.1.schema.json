      "required": ["value", "authority", "sourceLocatorIds", "boundary"],
      "properties": {
        "value": {"type": "string", "minLength": 30},
        "authority": {"enum": ["article_profile_specific_ish_context", "article_class_level_context"]},
        "sourceLocatorIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "boundary": {"type": "string", "minLength": 100}
      }
    },
    "fieldLocators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLocalLabel", "samplingCount", "sampleRegionMembership", "depositedSexFieldMembership", "markerPanel", "articleSpatialContext", "putativeAssignmentStatus", "missingEvidence"],
      "properties": {
        "sourceLocalLabel": {"$ref": "#/$defs/nonEmptyStringArray"},
        "samplingCount": {"$ref": "#/$defs/nonEmptyStringArray"},
        "sampleRegionMembership": {"$ref": "#/$defs/nonEmptyStringArray"},
        "depositedSexFieldMembership": {"$ref": "#/$defs/nonEmptyStringArray"},
        "markerPanel": {"$ref": "#/$defs/nonEmptyStringArray"},
        "articleSpatialContext": {"$ref": "#/$defs/nonEmptyStringArray"},
        "putativeAssignmentStatus": {"$ref": "#/$defs/nonEmptyStringArray"},
        "missingEvidence": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "missingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morphology",
        "somaGeometry",
        "nucleusGeometry",
        "cellCoordinates",
        "intracellularStructures",
        "organelles",
        "electrophysiology",
        "projectionTarget",
        "synapticConnectivity",
        "sciContext",
        "atlasRegistration",
        "crossSourceSameCellIdentityLink",
        "crossSourceSameTypeIdentityLink",
        "biologicalPrevalence"
      ],
      "properties": {
        "morphology": {"const": "not_measured"},
        "somaGeometry": {"const": "not_measured"},
        "nucleusGeometry": {"const": "not_measured"},
        "cellCoordinates": {"const": "not_available"},
        "intracellularStructures": {"const": "not_measured"},
        "organelles": {"const": "not_measured"},
        "electrophysiology": {"const": "not_linked_to_sequenced_nuclei"},
        "projectionTarget": {"const": "not_linked_to_sequenced_nuclei"},
        "synapticConnectivity": {"const": "not_linked_to_sequenced_nuclei"},
        "sciContext": {"const": "not_measured"},
        "atlasRegistration": {"const": "not_established"},
        "crossSourceSameCellIdentityLink": {"const": "not_established"},
        "crossSourceSameTypeIdentityLink": {"const": "not_established"},
        "biologicalPrevalence": {"const": "not_estimable_from_enriched_sample"}
      }
    }
  }
}
