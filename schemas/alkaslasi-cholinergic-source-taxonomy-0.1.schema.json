      "properties": {
        "species": {"const": "Mus musculus"},
        "speciesTaxonId": {"const": 10090},
        "lifeStage": {"const": "adult; 8 weeks"},
        "spinalRegion": {"type": "string", "minLength": 60},
        "modality": {"type": "string", "minLength": 80},
        "sourceTotalQcRetainedNucleusCount": {"const": 34231},
