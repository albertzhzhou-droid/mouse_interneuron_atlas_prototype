        "geoDisplayedSize": {"const": "325.8 Kb"},
        "compressedBytes": {"const": 333655},
        "compressedSha256": {"const": "6e69c106544a394dd23b6e7b4fc2d159a715aaa8a70adbd61721338e8d29c091"},
        "uncompressedBytes": {"const": 3372611},
        "uncompressedSha256": {"const": "d8ca3a504cbbc3a96050e0c98ad7ac04d1a9a0b791b94acbee7ef158840febc2"},
        "retrievedOn": {"type": "string", "format": "date"},
        "sourceFileBundled": {"const": false},
        "exactNucleusRosterBundled": {"const": false},
        "derivedFactualMetadataBundled": {"const": true},
        "reuseStatus": {"const": "PUBLIC_ACCESS_REUSE_NOT_ASSUMED"},
        "sourceLocatorIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "rightsBoundary": {"type": "string", "minLength": 150}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species",
        "speciesTaxonId",
        "lifeStage",
        "spinalRegion",
        "modality",
        "sourceTotalQcRetainedNucleusCount",
        "sourceCholinergicNucleusCount",
        "sourceInterneuronNucleusCount",
        "displayedProfileCount",
        "sourceLabelledCholinergicInterneuronProfileCount",
        "articlePax2HighProfileCount",
        "articleCautiousI8ProfileCount",
        "articleFinerInterneuronSubclassCount",
        "depositedFinerSubclassAssignmentsAvailable",
        "samplingCountInterpretation",
        "projectCanonicalTypeCount",
        "exactCrossSourceIdentityCount",
        "projectRegistrationCount",
        "generatedGeometryCount"
