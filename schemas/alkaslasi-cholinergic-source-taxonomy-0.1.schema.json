        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "accession", "recordUrl", "sraStudyAccession", "bioProjectAccession", "displayedCitationPmid", "citationLinkBoundary", "sampleFrame", "annotationAsset"],
          "properties": {
            "id": {"const": "GSE167597"},
            "accession": {"const": "GSE167597"},
            "recordUrl": {"const": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE167597"},
            "sraStudyAccession": {"const": "SRP308350"},
            "bioProjectAccession": {"const": "PRJNA705097"},
            "displayedCitationPmid": {"const": "37559423"},
            "citationLinkBoundary": {"type": "string", "minLength": 150},
            "sampleFrame": {"$ref": "#/$defs/sampleFrame"},
            "annotationAsset": {"$ref": "#/$defs/annotationAsset"}
          }
        }
      }
    },
