            "I1": {"const": ["Igsl3", "Prlr", "Cdh23"]},
            "I2": {"const": ["Chst9", "Lama2", "Pde5a"]},
            "I3": {"const": ["Sox6", "Col18a1", "9530026P05Rik"]},
            "I4": {"const": ["Zfp536", "Col18a1", "Pde11a"]},
            "I5": {"const": ["Gm13912", "Ror2", "Gm12649"]},
