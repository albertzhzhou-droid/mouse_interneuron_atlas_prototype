{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/alkaslasi-cholinergic-source-taxonomy-0.1.schema.json",
  "title": "Alkaslasi 2021 source-local adult mouse spinal cholinergic interneuron taxonomy 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseId",
    "schemaVersion",
    "releaseDate",
    "datasetId",
    "coordinateAuthority",
    "source",
    "scope",
    "articlePipelineStages",
    "articleFigure5aMarkerContext",
    "sourceObjectAudit",
    "excludedSourceContext",
    "sourceLocators",
    "profiles",
    "hardBoundaries"
  ],
  "properties": {
    "releaseId": {"const": "ohri-alkaslasi-cholinergic-source-taxonomy-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "releaseDate": {"type": "string", "format": "date"},
    "datasetId": {"const": "GSE167597"},
    "coordinateAuthority": {"const": "SOURCE_LOCAL_TYPE_ONLY"},
    "source": {"$ref": "#/$defs/source"},
    "scope": {"$ref": "#/$defs/scope"},
    "articlePipelineStages": {"$ref": "#/$defs/articlePipelineStages"},
    "articleFigure5aMarkerContext": {"$ref": "#/$defs/articleFigure5aMarkerContext"},
