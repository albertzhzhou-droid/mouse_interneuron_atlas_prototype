        "sourceLocatorIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "interpretationBoundary": {"type": "string", "minLength": 120}
      }
    },
    "annotationAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fileName",
        "downloadUrl",
        "geoDisplayedSize",
        "compressedBytes",
        "compressedSha256",
        "uncompressedBytes",
        "uncompressedSha256",
        "retrievedOn",
        "sourceFileBundled",
        "exactNucleusRosterBundled",
        "derivedFactualMetadataBundled",
        "reuseStatus",
        "sourceLocatorIds",
        "rightsBoundary"
