        "articleCautiousI8ProfileCount": {"const": 1},
        "articleFinerInterneuronSubclassCount": {"const": 14},
        "depositedFinerSubclassAssignmentsAvailable": {"const": false},
        "samplingCountInterpretation": {"const": "SAMPLING_COUNT_ONLY_NOT_PREVALENCE"},
        "projectCanonicalTypeCount": {"const": 0},
        "exactCrossSourceIdentityCount": {"const": 0},
        "projectRegistrationCount": {"const": 0},
        "generatedGeometryCount": {"const": 0}
      }
