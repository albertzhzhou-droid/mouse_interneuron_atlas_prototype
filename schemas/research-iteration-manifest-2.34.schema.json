        "releaseId": { "const": "ohri-mouse-interneuron-research-iteration-2.33.0" },
        "bytes": { "const": 109358 },
        "fileSha256": { "const": "6b2c1571c8dccf5aeced3518435dfe4bf0bff4c605f9a9255524299d72dda081" },
        "contentSha256": { "const": "1b4632ea19ea00b27422408bf96d4dabe39e7e23330d6511fe4b6ccdafa6752f" }
      }
    }
