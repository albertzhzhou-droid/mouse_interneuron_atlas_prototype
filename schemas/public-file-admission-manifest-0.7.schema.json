{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/public-file-admission-manifest-0.7.json",
  "title": "OHRI object-level public file-admission manifest 0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "manifestId", "sourceId", "dataset", "reviewDate", "files", "admissionDecision"],
  "properties": {
    "formatVersion": {"const": "0.7.0"},
    "manifestId": {"type": "string", "pattern": "^PFM-[A-Z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceId": {"enum": ["PDS-SPINALJ-PROCESSED", "PDS-CANOGOMEZ-2026"]},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["accession", "version", "landingPageUrl", "rightsDecision"], "properties": {"accession": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "landingPageUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "rightsDecision": {"enum": ["recorded_for_file", "pending_reject"]}}},
    "reviewDate": {"type": "string", "format": "date"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "admissionDecision": {"const": "metadata_only_not_downloaded_not_registered"}
  },
  "$defs": {
    "sourceChecksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "provenance"],
      "properties": {
        "algorithm": {"enum": ["sha1", "sha256"]},
        "value": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "provenance": {"const": "source_metadata"}
      },
      "allOf": [
        {"if": {"properties": {"algorithm": {"const": "sha1"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}},
        {"if": {"properties": {"algorithm": {"const": "sha256"}}}, "then": {"properties": {"value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stableName", "sourceUrl", "bytes", "format", "sourceChecksum", "localSha256", "rightsDecision", "coordinates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "stableName": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1},
        "sourceChecksum": {"$ref": "#/$defs/sourceChecksum"},
        "localSha256": {"const": null},
        "rightsDecision": {"const": "recorded_for_file"},
        "coordinates": {"type": "object", "additionalProperties": false, "required": ["unit", "axisOrder", "origin", "missingReason"], "properties": {"unit": {"type": ["string", "null"]}, "axisOrder": {"type": ["string", "null"]}, "origin": {"type": ["string", "null"]}, "missingReason": {"type": ["string", "null"]}}}
      }
    }
  }
}
