{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/hayashi-v2a-source-taxonomy-0.1.json",
  "title": "Hayashi 2018 source-local neonatal mouse V2a taxonomy 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseId",
    "schemaVersion",
    "releaseDate",
    "datasetId",
    "coordinateAuthority",
    "source",
    "scope",
    "sourceReportedMajorTypes",
    "sourceLocators",
    "profiles",
    "globalMissingEvidence",
    "hardBoundaries"
  ],
  "properties": {
    "releaseId": { "const": "ohri-hayashi-v2a-source-taxonomy-0.1.0" },
    "schemaVersion": { "const": "0.1.0" },
    "releaseDate": { "type": "string", "format": "date" },
    "datasetId": { "const": "GSE108788" },
    "coordinateAuthority": { "const": "SOURCE_LOCAL_TYPE_ONLY" },
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/scope" },
    "sourceReportedMajorTypes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/majorType" }
    },
    "sourceLocators": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/sourceLocator" }
    },
    "profiles": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/profile" }
    },
    "globalMissingEvidence": { "$ref": "#/$defs/globalMissingEvidence" },
    "hardBoundaries": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 50 }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "geo"],
      "properties": {
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "citation",
            "doi",
            "pmid",
            "pmcid",
            "articleUrl",
            "reuseStatus",
            "rightsBoundary"
          ],
          "properties": {
            "id": { "const": "HAYASHI-2018" },
            "citation": { "type": "string", "minLength": 120 },
            "doi": { "const": "10.1016/j.neuron.2018.01.023" },
            "pmid": { "const": "29398364" },
            "pmcid": { "const": "PMC8601153" },
            "articleUrl": { "const": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8601153/" },
            "reuseStatus": { "const": "PUBLIC_ACCESS_REUSE_NOT_ASSUMED" },
            "rightsBoundary": { "type": "string", "minLength": 120 }
          }
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "accession",
            "sampleAccession",
            "superSeriesAccession",
            "sraStudyAccession",
            "bioProjectAccession",
            "recordUrl",
            "overallDesign",
            "sampleFrame",
            "countMatrixAsset"
          ],
          "properties": {
            "id": { "const": "GSE108788" },
            "accession": { "const": "GSE108788" },
            "sampleAccession": { "const": "GSM2913270" },
            "superSeriesAccession": { "const": "GSE108790" },
            "sraStudyAccession": { "const": "SRP128071" },
            "bioProjectAccession": { "const": "PRJNA428534" },
            "recordUrl": { "const": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE108788" },
            "overallDesign": { "type": "string", "minLength": 120 },
            "sampleFrame": { "$ref": "#/$defs/sampleFrame" },
            "countMatrixAsset": { "$ref": "#/$defs/countMatrixAsset" }
          }
        }
      }
    },
    "sampleFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species",
        "speciesTaxonId",
        "geneticLabel",
        "lifeStage",
        "sex",
        "sampledSpinalRegions",
        "sourceAnimalCount",
        "prePoolingFACSCollectedCellCountByRegion",
        "pooledLibraryCount",
        "independentLibraryCount",
        "tenXChemistry",
        "animalResolvedReplicateCount",
        "cellsProcessedApproximate",
        "qcRetainedCellCount",
        "articleAssignedCervicalCellCount",
        "articleAssignedLumbarCellCount",
        "articleRegionAssignmentMethod",
        "cellRegionAssignmentAvailableInGeoMatrix",
        "interpretationBoundary"
      ],
      "properties": {
        "species": { "const": "Mus musculus" },
        "speciesTaxonId": { "const": 10090 },
        "geneticLabel": { "const": "Chx10:Cre; tdTomato" },
        "lifeStage": { "const": "P0 neonatal" },
        "sex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "missingReason"],
          "properties": {
            "value": { "type": "null" },
            "missingReason": { "const": "not_reported" }
          }
        },
        "sampledSpinalRegions": {
          "const": ["cervical", "lumbar"]
        },
        "sourceAnimalCount": { "const": 2 },
        "prePoolingFACSCollectedCellCountByRegion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cervical", "lumbar"],
          "properties": {
            "cervical": { "const": 2800 },
            "lumbar": { "const": 2800 }
          }
        },
        "pooledLibraryCount": { "const": 1 },
        "independentLibraryCount": { "const": 1 },
        "tenXChemistry": { "const": "Chromium Single Cell 3 prime v2" },
        "animalResolvedReplicateCount": { "const": 0 },
        "cellsProcessedApproximate": { "const": 3000 },
        "qcRetainedCellCount": { "const": 949 },
        "articleAssignedCervicalCellCount": { "const": 455 },
        "articleAssignedLumbarCellCount": { "const": 494 },
        "articleRegionAssignmentMethod": { "type": "string", "minLength": 100 },
        "cellRegionAssignmentAvailableInGeoMatrix": { "const": false },
        "interpretationBoundary": { "type": "string", "minLength": 180 }
      }
    },
    "countMatrixAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fileName",
        "archiveFileName",
        "downloadUrl",
        "archiveBytes",
        "archiveSha256",
        "compressedBytes",
        "compressedSha256",
        "uncompressedBytes",
        "uncompressedSha256",
        "geneRowCount",
        "cellBarcodeColumnCount",
        "geneInclusionRule",
        "metadataColumns",
        "matrixReanalysis",
        "clusterAnnotationColumnAvailable",
        "majorTypeAnnotationColumnAvailable",
        "spinalRegionAnnotationColumnAvailable",
        "sourceFileBundled",
        "derivedFactualMetadataBundled",
        "reuseStatus",
        "rightsBoundary"
      ],
      "properties": {
        "id": { "const": "GSM2913270_UMI_GENE_COUNTS" },
        "fileName": { "const": "GSM2913270_umiGeneCounts.csv.gz" },
        "archiveFileName": { "const": "GSE108788_RAW.tar" },
        "downloadUrl": { "const": "https://ftp.ncbi.nlm.nih.gov/geo/series/GSE108nnn/GSE108788/suppl/GSE108788_RAW.tar" },
        "archiveBytes": { "const": 3604480 },
        "archiveSha256": { "const": "7bf234f91c12ff09b5d132cb84a91c7bdafd96158f93a5c7083b5062f5c8fd97" },
        "compressedBytes": { "const": 3597244 },
        "compressedSha256": { "const": "d6d55f8780c7102fd71fe66e037dac6f48638c97ce2124b331c498e3fb73f8de" },
        "uncompressedBytes": { "const": 24981295 },
        "uncompressedSha256": { "const": "a0d97a23ac28700e621ca90a6725b6bfb38f645094affa8289ed922ce33f9753" },
        "geneRowCount": { "const": 12986 },
        "cellBarcodeColumnCount": { "const": 949 },
        "geneInclusionRule": { "type": "string", "minLength": 70 },
        "metadataColumns": { "const": ["gene_name"] },
        "matrixReanalysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "countingRule",
            "v2aMarkerPanel",
            "v2aMarkerPositiveBarcodeCount",
            "v2aMarkerPositivePercentage",
            "articleReportedV2aMarkerPositivePercentage",
            "slc17a6PositiveBarcodeCount",
            "slc17a6PositivePercentage",
            "articleReportedSlc17a6PositivePercentage",
            "reproducibilityStatus",
            "interpretationBoundary"
          ],
          "properties": {
            "countingRule": { "type": "string", "minLength": 80 },
            "v2aMarkerPanel": { "const": ["Vsx2", "Sox14", "Shox2", "Lhx3", "Lhx4"] },
            "v2aMarkerPositiveBarcodeCount": { "const": 942 },
            "v2aMarkerPositivePercentage": { "const": 99.262 },
            "articleReportedV2aMarkerPositivePercentage": { "const": 99.5 },
            "slc17a6PositiveBarcodeCount": { "const": 862 },
            "slc17a6PositivePercentage": { "const": 90.832 },
            "articleReportedSlc17a6PositivePercentage": { "const": 92.7 },
            "reproducibilityStatus": { "const": "unresolved_difference_from_article_report" },
            "interpretationBoundary": { "type": "string", "minLength": 180 }
          }
        },
        "clusterAnnotationColumnAvailable": { "const": false },
        "majorTypeAnnotationColumnAvailable": { "const": false },
        "spinalRegionAnnotationColumnAvailable": { "const": false },
        "sourceFileBundled": { "const": false },
        "derivedFactualMetadataBundled": { "const": true },
        "reuseStatus": { "const": "PUBLIC_ACCESS_REUSE_NOT_ASSUMED" },
        "rightsBoundary": { "type": "string", "minLength": 180 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species",
        "speciesTaxonId",
        "lifeStage",
        "condition",
        "spinalRegion",
        "modality",
        "reportedClusterCount",
        "displayedProfileCount",
        "reportedQcRetainedCellCount",
        "figureClusterCellCountSum",
        "exactClusterBarcodeMappingAvailable",
        "exactMajorTypeBarcodeMappingAvailable",
        "exactCrossSourceIdentityCount",
        "projectRegistrationCount",
        "projectConfirmedLocalInterneuronProfileCount",
        "projectMixedLocalProjectionContextProfileCount"
      ],
      "properties": {
        "species": { "const": "Mus musculus" },
        "speciesTaxonId": { "const": 10090 },
        "lifeStage": { "const": "P0 neonatal" },
        "condition": { "const": "developmental_uninjured" },
        "spinalRegion": { "const": "cervical and lumbar spinal cord" },
        "modality": { "const": "single-cell RNA sequencing" },
        "reportedClusterCount": { "const": 11 },
        "displayedProfileCount": { "const": 11 },
        "reportedQcRetainedCellCount": { "const": 949 },
        "figureClusterCellCountSum": { "const": 949 },
        "exactClusterBarcodeMappingAvailable": { "const": false },
        "exactMajorTypeBarcodeMappingAvailable": { "const": false },
        "exactCrossSourceIdentityCount": { "const": 0 },
        "projectRegistrationCount": { "const": 0 },
        "projectConfirmedLocalInterneuronProfileCount": { "const": 0 },
        "projectMixedLocalProjectionContextProfileCount": { "const": 11 }
      }
    },
    "majorType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "chx10Context",
        "networkContext",
        "projectionContext",
        "projectUseClass",
        "authority",
        "exactBarcodeAssignmentAvailable",
        "sameCellProjectionTraceAvailable",
        "sourceLocatorIds"
      ],
      "properties": {
        "id": { "enum": ["hayashi-2018:type-i", "hayashi-2018:type-ii"] },
        "label": { "enum": ["Type I", "Type II"] },
        "chx10Context": { "enum": ["high_or_maintained", "downregulated_or_low"] },
        "networkContext": { "type": "string", "minLength": 25 },
        "projectionContext": { "type": "string", "minLength": 25 },
        "projectUseClass": {
          "enum": [
            "local_interneuron_context",
            "projection_neuron_context_excluded_from_local_interneuron_count"
          ]
        },
        "authority": { "const": "source_reported_population_level" },
        "exactBarcodeAssignmentAvailable": { "const": false },
        "sameCellProjectionTraceAvailable": { "const": false },
        "sourceLocatorIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceObjectId", "locator", "supportsFields", "evidenceStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "sourceObjectId": {
          "enum": ["HAYASHI-2018", "GSE108788", "GSM2913270_UMI_GENE_COUNTS"]
        },
        "locator": { "type": "string", "minLength": 80 },
        "supportsFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sampleFrame",
              "lifeStage",
              "spinalScope",
              "matrixReceipt",
              "matrixReanalysis",
              "qcCellDenominator",
              "missingBarcodeMappings",
              "majorType",
              "majorTypeMembership",
              "networkContext",
              "projectionContext",
              "sameCellBoundary",
              "transmitterContext",
              "sourceLocalLabel",
              "samplingCount",
              "markerPanel",
              "spatialDomainContext",
              "rostrocaudalContext",
              "analysisAuthority",
              "rightsBoundary",
              "missingEvidence"
            ]
          }
        },
        "evidenceStatus": {
          "enum": ["direct", "derived", "contextual", "not_measured", "rights_boundary"]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceLocalLabel",
        "samplingCount",
        "markerPanel",
        "spatialDomainContext",
        "rostrocaudalContext",
        "majorTypeMembership",
        "chx10LowContext",
        "projectUseClass",
        "fieldLocatorIds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^hayashi-2018:GSE108788:cluster-(?:[1-9]|1[01])$" },
        "sourceLocalLabel": { "type": "string", "pattern": "^Cluster (?:[1-9]|1[01])$" },
        "samplingCount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "interpretation"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "unit": { "const": "cells" },
            "interpretation": { "const": "article_figure_cluster_count" }
          }
        },
        "markerPanel": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "spatialDomainContext": { "enum": ["lateral", "medial", "not_established"] },
        "rostrocaudalContext": {
          "enum": ["mostly_cervical", "lumbar_enriched", "mixed_cervical_lumbar", "not_established"]
        },
        "majorTypeMembership": { "const": "mixed_type_i_and_type_ii" },
        "chx10LowContext": {
          "enum": ["highest_fraction_group", "mixture_not_quantified_in_contract"]
        },
        "projectUseClass": { "const": "v2a_cluster_mixed_local_and_supraspinal_projection_context" },
        "fieldLocatorIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "globalMissingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singleCellMorphology",
        "cellCoordinates",
        "sameCellProjectionTracing",
        "barcodeLevelClusterAssignment",
        "barcodeLevelMajorTypeAssignment",
        "barcodeLevelSpinalRegionAssignment",
        "synapticConnectivity",
        "atlasRegistration",
        "adultIdentity",
        "sciContext",
        "animalResolvedReplication",
        "exactCrossSourceIdentity"
      ],
      "properties": {
        "singleCellMorphology": { "const": "not_measured" },
        "cellCoordinates": { "const": "not_available" },
        "sameCellProjectionTracing": { "const": "not_available" },
        "barcodeLevelClusterAssignment": { "const": "not_available_in_public_geo_object" },
        "barcodeLevelMajorTypeAssignment": { "const": "not_available_in_public_geo_object" },
        "barcodeLevelSpinalRegionAssignment": { "const": "not_available_in_public_geo_object" },
        "synapticConnectivity": { "const": "not_available_as_edge_list" },
        "atlasRegistration": { "const": "not_established" },
        "adultIdentity": { "const": "not_established" },
        "sciContext": { "const": "not_measured" },
        "animalResolvedReplication": { "const": "not_available_after_pooling" },
        "exactCrossSourceIdentity": { "const": "not_established" }
      }
    }
  }
}
