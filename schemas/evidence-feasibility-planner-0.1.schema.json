{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/evidence-feasibility-planner-0.1.json",
  "title": "OHRI public-source research-question feasibility planner 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "catalogReleaseId", "title", "selectedAxisLimit", "publicSourceIds", "axes", "routes", "unqualifiedAxisDecision", "multiRouteDecision", "localRuntime", "scientificBoundary", "nextQueueItems"],
  "properties": {
    "releaseId": {"const": "ohri-evidence-feasibility-planner-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "catalogReleaseId": {"const": "ohri-mouse-interneuron-public-data-workbench-0.4.0"},
    "title": {"type": "string", "minLength": 1},
    "selectedAxisLimit": {"const": 4},
    "publicSourceIds": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^PDS-[A-Z0-9-]+$"}},
    "axes": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/axis"}},
    "routes": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/route"}},
    "unqualifiedAxisDecision": {"type": "string", "minLength": 1},
    "multiRouteDecision": {"type": "string", "minLength": 1},
    "localRuntime": {"type": "object", "additionalProperties": false, "required": ["networkRequests", "sourceFileDownload", "sourceFileUpload", "persistentStorage", "output"], "properties": {"networkRequests": {"const": false}, "sourceFileDownload": {"const": false}, "sourceFileUpload": {"const": false}, "persistentStorage": {"const": "none"}, "output": {"const": "browser_download_of_feasibility_receipt_json"}}},
    "scientificBoundary": {"type": "string", "minLength": 1},
    "nextQueueItems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^UPG-[0-9]{3}$"}}
  },
  "$defs": {
    "axis": {"type": "object", "additionalProperties": false, "required": ["id", "label", "description"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "sourceIds", "supportedAxisIds", "readiness", "label", "boundary"], "properties": {"id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"}, "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PDS-[A-Z0-9-]+$"}}, "supportedAxisIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}}, "readiness": {"enum": ["bundled_reference_inferred", "bundled_local_unregistered", "metadata_audited_not_admitted", "preprint_metadata_audited_not_admitted", "derived_type_level_attributed", "metadata_audit_required", "metadata_audited_aggregate_or_spot_level"]}, "label": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1}}}
  }
}
