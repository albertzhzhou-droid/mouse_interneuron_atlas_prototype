{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/russ-harmonized-taxonomy-crosswalk-0.1.json",
  "title": "Russ 2021 harmonized mouse spinal-cord taxonomy crosswalk 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "releaseDate", "sourceId", "coordinateAuthority", "source", "scope", "groups", "populations", "prototypeCrosswalks", "hardBoundaries"],
  "properties": {
    "releaseId": {"const": "ohri-russ-harmonized-taxonomy-crosswalk-0.1.0"},
    "schemaVersion": {"const": "0.1.0"},
    "releaseDate": {"type": "string", "format": "date"},
    "sourceId": {"const": "PDS-RUSS-2021"},
    "coordinateAuthority": {"const": "TYPE_LEVEL"},
    "source": {"$ref": "#/$defs/source"},
    "scope": {"$ref": "#/$defs/scope"},
    "groups": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/group"}},
    "populations": {"type": "array", "minItems": 69, "items": {"$ref": "#/$defs/population"}},
    "prototypeCrosswalks": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/crosswalk"}},
    "hardBoundaries": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["publication", "processedCounts", "markerTable"],
      "properties": {
        "publication": {"type": "object", "additionalProperties": false, "required": ["citation", "doi", "articleUrl", "license"], "properties": {"citation": {"type": "string", "minLength": 1}, "doi": {"const": "10.1038/s41467-021-25125-1"}, "articleUrl": {"const": "https://www.nature.com/articles/s41467-021-25125-1"}, "license": {"type": "string", "minLength": 1}}},
        "processedCounts": {"type": "object", "additionalProperties": false, "required": ["accession", "recordUrl", "status"], "properties": {"accession": {"const": "GEO GSE158380"}, "recordUrl": {"const": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE158380"}, "status": {"type": "string", "minLength": 1}}},
        "markerTable": {"type": "object", "additionalProperties": false, "required": ["title", "fileName", "sourceUrl", "bytes", "sha256", "retrievedOn", "sourceFileBundled", "derivedMetadataBundled", "derivation"], "properties": {"title": {"type": "string", "minLength": 1}, "fileName": {"type": "string", "minLength": 1}, "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "retrievedOn": {"type": "string", "format": "date"}, "sourceFileBundled": {"const": false}, "derivedMetadataBundled": {"const": true}, "derivation": {"type": "string", "minLength": 1}}}
      }
    },
    "scope": {"type": "object", "additionalProperties": false, "required": ["reportedNeuralPopulationCount", "displayedPopulationCount", "displayedInterneuronCandidateCount", "lifeStage", "spatialBoundary", "knownSourceCaution"], "properties": {"reportedNeuralPopulationCount": {"const": 69}, "displayedPopulationCount": {"const": 69}, "displayedInterneuronCandidateCount": {"const": 65}, "lifeStage": {"type": "string", "minLength": 1}, "spatialBoundary": {"type": "string", "minLength": 1}, "knownSourceCaution": {"type": "string", "minLength": 1}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "label", "regionClass", "transmitterClass", "interneuronCandidate", "populationLabels", "sourceScope"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "label": {"type": "string", "minLength": 1}, "regionClass": {"enum": ["dorsal", "deep_dorsal_or_mid", "ventral", "central"]}, "transmitterClass": {"enum": ["excitatory", "inhibitory", "cholinergic", "inhibitory_reported"]}, "interneuronCandidate": {"type": "boolean"}, "populationLabels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "sourceScope": {"type": "string", "minLength": 1}}},
    "population": {"type": "object", "additionalProperties": false, "required": ["id", "label", "groupId", "primaryMarkers", "markerEvidence"], "properties": {"id": {"type": "string", "pattern": "^RUSS-[A-Za-z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "groupId": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "primaryMarkers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}}, "markerEvidence": {"type": "string", "minLength": 1}}},
    "crosswalk": {"type": "object", "additionalProperties": false, "required": ["entityId", "mappingStatus", "candidateGroupIds", "candidatePopulationLabels", "reason", "notEstablished"], "properties": {"entityId": {"type": "string", "pattern": "^mouse\\."}, "mappingStatus": {"enum": ["no_unique_mapping", "broad_candidate_only", "marker_context_only", "axis_only"]}, "candidateGroupIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}, "candidatePopulationLabels": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "minLength": 1}, "notEstablished": {"type": "string", "minLength": 1}}}
  }
}
