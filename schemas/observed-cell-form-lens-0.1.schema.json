{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/observed-cell-form-lens-0.1.schema.json",
  "title": "Observed cell-form lens 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "releasedAt", "title", "purpose", "sourceObject", "defaultNeuronId", "records", "renderingContract", "hardBoundaries"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "releaseId": { "const": "ohri-observed-cell-form-lens-0.1.0" },
    "releasedAt": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "assetManifestSha256", "repository", "repositoryRelease", "repositoryRrid", "license", "rightsUrl", "bundled"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assetManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repository": { "const": "NeuroMorpho.Org" },
        "repositoryRelease": { "type": "string", "minLength": 1 },
        "repositoryRrid": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "rightsUrl": { "type": "string", "format": "uri" },
        "bundled": { "const": true }
      }
    },
    "defaultNeuronId": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["neuronId", "assetId", "phenotype", "transmitter", "domain", "physicalIntegrity", "sourcePaperDoi", "segmentCount", "geometryStatus", "sourceFrame", "registrationStatus"],
        "properties": {
          "neuronId": { "type": "integer", "minimum": 1 },
          "assetId": { "type": "string", "pattern": "^NeuroMorpho:[0-9]+$" },
          "phenotype": { "type": "string", "minLength": 1 },
          "transmitter": { "enum": ["excitatory", "inhibitory"] },
          "domain": { "type": "string", "minLength": 1 },
          "physicalIntegrity": { "type": "string", "minLength": 1 },
          "sourcePaperDoi": { "type": "string", "minLength": 1 },
          "segmentCount": { "type": "integer", "minimum": 1 },
          "geometryStatus": { "const": "OBS" },
          "sourceFrame": { "const": "NeuroMorpho_CNG_standardized_local_frame" },
          "registrationStatus": { "const": "unregistered" }
        }
      }
    },
    "renderingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["populationEvidenceLane", "observedCellFormLane", "selectionDoesNotCreateRelationship", "coDisplayDoesNotCreateRelationship"],
      "properties": {
        "populationEvidenceLane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometryStatus", "representation", "cellMorphologyClaim", "purpose"],
          "properties": {
            "geometryStatus": { "const": "SYN" },
            "representation": { "const": "non-cell evidence node" },
            "cellMorphologyClaim": { "const": false },
            "purpose": { "type": "string", "minLength": 1 }
          }
        },
        "observedCellFormLane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometryStatus", "representation", "displayTransform", "measurementUse", "coordinateRelationshipToAtlas", "coordinateRelationshipToPopulationEvidence", "projectRegistrationCount", "exactCrossSourceIdentityCount"],
          "properties": {
            "geometryStatus": { "const": "OBS" },
            "representation": { "const": "source segment geometry" },
            "displayTransform": { "type": "string", "minLength": 1 },
            "measurementUse": { "type": "string", "minLength": 1 },
            "coordinateRelationshipToAtlas": { "const": "none" },
            "coordinateRelationshipToPopulationEvidence": { "const": "none" },
            "projectRegistrationCount": { "const": 0 },
            "exactCrossSourceIdentityCount": { "const": 0 }
          }
        },
        "selectionDoesNotCreateRelationship": { "const": true },
        "coDisplayDoesNotCreateRelationship": { "const": true }
      }
    },
    "hardBoundaries": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
