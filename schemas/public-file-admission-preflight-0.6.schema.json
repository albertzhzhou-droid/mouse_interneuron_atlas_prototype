{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/public-file-admission-preflight-0.6.json",
  "title": "OHRI public file-admission preflight status 0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "preflightId", "schemaPath", "status", "sourceId", "automaticDownload", "credentialStorage", "candidateFilesAccepted", "rejectionRules", "nextQueueItem"],
  "properties": {
    "formatVersion": {"const": "0.6.0"},
    "preflightId": {"type": "string", "pattern": "^PFP-[A-Z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "schemaPath": {"const": "schemas/public-file-admission-manifest.schema.json"},
    "status": {"const": "awaiting_object_level_public_manifest"},
    "sourceId": {"const": "PDS-SPINALJ-PROCESSED"},
    "automaticDownload": {"const": false},
    "credentialStorage": {"const": false},
    "candidateFilesAccepted": {"const": 0},
    "rejectionRules": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "nextQueueItem": {"const": "UPG-001A"}
  }
}
