{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohri.example/schemas/curator-adjudication-contract-1.0.json",
  "title": "OHRI curator adjudication contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adjudicationSchemaVersion", "feedbackSchemaVersion", "distributionVersion", "workbenchReleaseId", "minimumIndependentCurators", "permittedDispositions", "privacy", "boundary"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "adjudicationSchemaVersion": {"const": "1.0.0"},
    "feedbackSchemaVersion": {"const": "1.1.0"},
    "distributionVersion": {"const": "1.0.0-curator.1"},
    "workbenchReleaseId": {"const": "ohri-mouse-interneuron-public-data-workbench-1.0.0"},
    "minimumIndependentCurators": {"const": 2},
    "permittedDispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "privacy": {"const": "Created locally; not uploaded."},
    "boundary": {"type": "string", "minLength": 1}
  }
}
