# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local OpenAI hosting project identifiers are workspace configuration.
/.openai/hosting.json

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/output/
/work/
**/.playwright-cli/
/release/
__pycache__/
*.py[cod]
*.tsbuildinfo

# Cano-Gomez source RDS objects remain link-only; only validated derivatives ship.
**/GSE318731_*.rds

# Exact SpinalCordNET source is retained once outside browser assets.
/data/source-candidates/dandi-spinalcordnet-full-20261002/*.nwb
/data/source-candidates/dandi-spinalcordnet-full-20261002/*.partial
# I36 exact original supplementary archives/PDFs are retained outside public.
/data/source-candidates/svara-supplements-20261002/*.zip
/data/source-candidates/svara-supplements-20261002/*.pdf
# I38 exact originals remain outside browser assets; extracted tables have receipts.
/data/source-candidates/freidok-145135-20261002/*.zip
/data/source-candidates/freidok-145135-20261002/*.pdf
/data/source-candidates/svara-contacts-20261002/*.xlsx

# Public handoff: preserve local originals behind unresolved rights/config gates.
/data/source-candidates/russ-geo-original-audit-20261005/GSE158380_cells.csv.gz
/data/source-candidates/russ-geo-original-audit-20261005/GSE158380_features.updated-11-22-2022.csv.gz
/data/source-candidates/svara-supplements-20261002/publisher-supplement-policy.html
/data/source-candidates/mccreedy-v2a-20261002/publisher.html.txt
/docs/qa/2026-10-05-implementation-63/accepted-i63-owned-and-layout-checkpoint.zip
/docs/qa/2026-10-07-implementation-64/exact-accepted-i63-checkpoint.zip
/docs/qa/2026-10-07-implementation-64/accepted-i64-owned-and-layout-checkpoint.zip
